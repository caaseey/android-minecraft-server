# Copy to ~/.config/android-minecraft-server/backup.env and adapt locally.
BACKUP_SOURCE_DIR="$HOME/minecraft"
BACKUP_DIR="$HOME/minecraft-backups"
TMUX_SESSION="mcserver"
SSH_TARGET="backupuser@192.0.2.10"
SSH_KEY="$HOME/.ssh/id_ed25519"
REMOTE_SCP_DIR="/C:/MinecraftBackups/received"
REMOTE_HASH_DIR="C:\\MinecraftBackups\\received"
SAVE_SETTLE_SECONDS="5"
KEEP_LOCAL_BACKUPS="2"

# Copy to ~/.config/android-minecraft-server/server.env and edit for your setup.
SERVER_DIR="$HOME/minecraft"
SERVER_JAR="server.jar"
TMUX_SESSION="mcserver"
JAVA_BIN="java"
JAVA_OPTS="-Xms512M -Xmx2G"
PAPER_MINECRAFT_VERSION="CHANGE_ME"
PAPER_USER_AGENT="android-minecraft-server-portfolio/1.0 (https://github.com/caaseey/android-minecraft-server)"
